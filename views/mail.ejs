<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>File Shared With You</title>
</head>

<body style="margin:0; padding:0; background:#f4f6fb; font-family:Arial, sans-serif;">

  <!-- Container -->
  <div style="max-width:600px; margin:40px auto; background:#ffffff; border-radius:12px; overflow:hidden; border:1px solid #eaeaea;">

    <!-- Header -->
    <div style="background:#070A12; padding:24px; text-align:center;">
      <h2 style="color:#ffffff; margin:0; font-size:20px;">
        📁 File Shared With You
      </h2>
      <p style="color:#9ca3af; margin-top:6px; font-size:13px;">
        Secure file transfer
      </p>
    </div>

    <!-- Body -->
    <div style="padding:24px; text-align:center;">

      <p style="font-size:14px; color:#333;">
        You have received a file. Click the button below to download it securely.
      </p>

      <!-- File Info -->
      <div style="margin:20px 0; padding:12px; background:#f9fafb; border:1px solid #eee; border-radius:8px;">
        <p style="margin:0; font-size:14px; color:#111;">
          <strong>File Name:</strong> <%=file.filename%>
        </p>
        <p style="margin:6px 0 0; font-size:12px; color:#666;">
          Size: <%=file.size%> KB
        </p>
      </div>

      <!-- Download Button -->
      <a href="<%=downloadFile%>"
         style="display:inline-block; margin-top:10px; padding:12px 20px;
                background:#111827; color:#ffffff; text-decoration:none;
                border-radius:8px; font-size:14px;">
        Download File
      </a>

      <!-- Link fallback -->
      <p style="margin-top:20px; font-size:12px; color:#777;">
        If button doesn’t work, open download Link:
      </p>

      <a href="<%=downloadlink%>"
      style="font-size:12px; color:#2563eb; word-break:break-all;">
        Download Link
      </a>

    </div>

    <!-- Footer -->
    <div style="padding:16px; text-align:center; font-size:11px; color:#999; border-top:1px solid #eee;">
      This file will expire in 24 hours for security reasons.
    </div>

  </div>

</body>
</html>