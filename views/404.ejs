<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>404 • LinkShare</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="min-h-screen flex items-center justify-center bg-[#070A12] overflow-hidden">

  <!-- Gradient Blobs -->
  <div class="absolute w-[500px] h-[500px] bg-purple-500/30 blur-[120px] rounded-full top-[-150px] left-[-150px]"></div>
  <div class="absolute w-[450px] h-[450px] bg-cyan-400/25 blur-[120px] rounded-full bottom-[-150px] right-[-150px]"></div>
  <div class="absolute w-[350px] h-[350px] bg-pink-500/20 blur-[120px] rounded-full top-[30%] left-[40%]"></div>

  <!-- Glass Card -->
  <div
    class="relative w-[92%] max-w-xl rounded-3xl
           bg-white/5 backdrop-blur-2xl
           border border-white/10
           shadow-2xl p-10 text-center"
  >

    <!-- Error -->
    <div class="text-8xl font-bold tracking-tight
                bg-gradient-to-r from-cyan-300 via-white to-purple-300
                bg-clip-text text-transparent">
      404
    </div>

    <h1 class="mt-4 text-2xl font-semibold text-white">
      Page Not Found
    </h1>

    <p class="mt-3 text-sm text-white/60 leading-relaxed">
      The page you're looking for doesn't exist,
      has expired, or the link is no longer available.
    </p>

    <!-- Status Badge -->
    <div class="mt-5 inline-flex items-center gap-2 px-3 py-1
                rounded-full bg-white/5 border border-white/10
                text-xs text-white/50">
      ⚠️ Invalid or expired link
    </div>

    <!-- Buttons -->
    <div class="mt-8 flex justify-center gap-3">

      <a href="/"
         class="px-6 py-3 rounded-xl
                     bg-white/5
                     border border-white/10
                     text-white text-sm
                     hover:bg-white/10
                     transition">
        Go Home
      </a>

    </div>

    <!-- Footer -->
    <p class="mt-8 text-xs text-white/30">
      LinkShare • Secure file sharing
    </p>

  </div>

</body>
</html>