<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>LinkShare</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="min-h-screen flex items-center justify-center bg-[#070A12] overflow-hidden">

  <!-- Soft gradient blobs -->
  <div class="absolute w-[500px] h-[500px] bg-purple-500/30 blur-[120px] rounded-full top-[-150px] left-[-150px]"></div>
  <div class="absolute w-[450px] h-[450px] bg-cyan-400/25 blur-[120px] rounded-full bottom-[-150px] right-[-150px]"></div>
  <div class="absolute w-[350px] h-[350px] bg-pink-500/20 blur-[120px] rounded-full top-[30%] left-[40%]"></div>

  <!-- Main Glass Card -->
  <div
    id="dropzone"
    class="relative w-[92%] max-w-xl rounded-3xl
           bg-white/5 backdrop-blur-2xl
           border border-white/10
           shadow-2xl"
  >

    <!-- Header -->
    <div class="px-8 py-6 text-center border-b border-white/10">
      <h1 class="text-xl font-semibold text-white">
        Upload Your Files
      </h1>
      <p class="text-sm text-white/60 mt-1">
        Drag & drop or click to upload
      </p>
        <div class="mt-3 inline-flex items-center gap-2 px-3 py-1
                    rounded-full bg-white/5 border border-white/10
                    text-xs text-white/50">
                        ⚠️ Max file size: 100 MB
        </div>
          <div class="inline-flex items-center gap-2 px-3 py-1
              rounded-full bg-white/5 border border-white/10
              text-xs text-white/40">
                ⏳ Files are automatically deleted after 24 hours
            </div>
    </div>



    <!-- Drop Area -->
    <form action="/api/upload" method="post" class="p-8" enctype="multipart/form-data">
      <input id="fileInput" type="file" multiple class="hidden" name="myfile"/>

      <div
        id="dropArea"
        class="group border border-dashed border-white/20
               rounded-2xl p-12 text-center cursor-pointer
               transition duration-300
               hover:border-cyan-300/60 hover:bg-white/5"
      >

        <!-- Icon -->
        <div class="text-5xl mb-4">📁</div>

        <p class="text-white text-lg font-medium">
          Drop files here
        </p>

        <p class="text-white/50 text-sm mt-1">
          or click to browse your device
        </p>

        <p class="text-white/30 text-xs mt-6">
          Supports images, PDFs, docs, zip
        </p>
      </form>

      <!-- File List -->
      <ul id="fileList" class="mt-6 space-y-2"></ul>
    </div>
  </div>

  <script>
    const dropzone = document.getElementById("dropzone");
    const dropArea = document.getElementById("dropArea");
    const fileInput = document.getElementById("fileInput");
    const fileList = document.getElementById("fileList");

    function renderFiles(files) {
      fileList.innerHTML = "";

      [...files].forEach(file => {
        const li = document.createElement("li");

        li.className =
          "flex justify-between items-center px-4 py-3 " +
          "rounded-xl bg-white/5 border border-white/10 " +
          "backdrop-blur-md";

        li.innerHTML = `
          <span class="text-sm text-white/80">${file.name}</span>
          <span class="text-xs text-white/40">${(file.size / 1024).toFixed(1)} KB</span>
        `;

        fileList.appendChild(li);
      });
    }

    dropArea.addEventListener("click", () => fileInput.click());

    fileInput.addEventListener("change", (e) => {
      renderFiles(e.target.files);
    });

    dropzone.addEventListener("dragover", (e) => {
      e.preventDefault();
      dropArea.classList.add("border-cyan-300/60", "bg-white/5");
    });

    dropzone.addEventListener("dragleave", () => {
      dropArea.classList.remove("border-cyan-300/60", "bg-white/5");
    });

    // dropzone.addEventListener("drop", (e) => {

      // e.preventDefault();

      // dropArea.classList.remove("border-cyan-300/60", "bg-white/5");

      // const files = e.dataTransfer.files;
      // fileInput.files = files;
      // renderFiles(files);

    //    e.preventDefault();

    //   const file = e.dataTransfer.files[0];

    //   if (e.dataTransfer.files.length > 1) {
    //     alert("Only one file can be uploaded at a time");
    //     return;
    //   }

    //   if (!file) return;

    //   fileInput.files = e.dataTransfer.files;
    //   if (fileInput.files.length > 0) {
    //     form.submit();
    //   }
    // });

    const form = document.querySelector("form");

dropzone.addEventListener("drop", (e) => {
  e.preventDefault();

  const { files } = e.dataTransfer;

  if (files.length !== 1) {
    alert("Please upload exactly one file.");
    return;
  }

  fileInput.files = files;
  renderFiles(files);

  form.submit();
});
  </script>

  <!-- Toast Container -->
  <% if (error) { %>
    <div id="toast"
     class="fixed top-6 right-6 z-50">
  
    <div id="toastBox"
        class="px-4 py-3 rounded-xl shadow-lg
                bg-black/80 border border-white/10
                text-white text-sm backdrop-blur-md
                transition-all duration-300">
      
      <span id="toastMessage"><%=error%></span>
    </div>
    </div>

    <script>
      setTimeout(() => {
          const toast = document.getElementById("toast");
          if (toast) {
              toast.style.display = "none";
          }
      }, 10000);
    </script>
    
  <% } %>


</body>
</html>