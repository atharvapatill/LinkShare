<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Download File</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>

<body class="min-h-screen flex items-center justify-center bg-[#070A12] overflow-hidden">
  <!-- Background Blobs -->
  <div class="absolute w-[500px] h-[500px] bg-purple-500/30 blur-[120px] rounded-full top-[-150px] left-[-150px]"></div>
  <div class="absolute w-[450px] h-[450px] bg-cyan-400/25 blur-[120px] rounded-full bottom-[-150px] right-[-150px]"></div>
  <div class="absolute w-[350px] h-[350px] bg-pink-500/20 blur-[120px] rounded-full top-[30%] left-[40%]"></div>

  <!-- 🧊 Download Card -->
  <div class="relative w-[92%] max-w-xl rounded-3xl
              bg-white/5 backdrop-blur-2xl
              border border-white/10 shadow-2xl">

    <!-- Header -->
    <div class="px-8 py-6 text-center border-b border-white/10">
      <h1 class="text-xl font-semibold text-white">
        Your File is Ready
      </h1>
      <p class="text-sm text-white/60 mt-1">
        Secure download available for a limited time
      </p>

      <div class="mt-3 inline-flex items-center gap-2 px-3 py-1
                  rounded-full bg-white/5 border border-white/10
                  text-xs text-white/40">
        ⏳ This file will expire in 24 hours
      </div>
    </div>

    <!-- File Info -->
    <div class="p-8 text-center">

      <!-- File Icon -->
      <div class="text-5xl mb-4">📄</div>

      <!-- File Name -->
      <h2 class="text-white text-lg font-medium">
        <%=file.filename%>
      </h2>


      <!-- Meta Info -->
      <div class="mt-6 flex justify-center gap-3 text-xs text-white/50">
        <span class="px-3 py-1 rounded-full bg-white/5 border border-white/10">
          Secure Link
        </span>
        <span class="px-3 py-1 rounded-full bg-white/5 border border-white/10">
          No Preview Available
        </span>
      </div>

      <!-- Download Button -->
<a href="/api/download/<%=`${file.filename}`%>"
   class="mt-8 inline-flex items-center justify-center gap-2
          px-6 py-3 rounded-xl
          bg-white/10 border border-white/15
          text-white text-sm font-medium
          hover:bg-white/15 transition">
  
  Download
</a>





    </div>
  </div>

</body>
</html>